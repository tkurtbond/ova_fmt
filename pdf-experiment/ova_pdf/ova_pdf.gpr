with "config/ova_pdf_config.gpr";
project Ova_Pdf is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Ova_Pdf_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("ova_pdf.adb");

   package Compiler is
      for Default_Switches ("Ada") use Ova_Pdf_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Ova_Pdf;
